{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "legionv4",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Legion v4 theme",
      "description": "Semantic light and dark tokens for Legion v4.",
      "cssVars": {
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.45 0.18 293)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.965 0.005 293)",
          "secondary-foreground": "oklch(0.25 0.02 293)",
          "muted": "oklch(0.965 0 0)",
          "muted-foreground": "oklch(0.45 0 0)",
          "accent": "oklch(0.955 0.02 293)",
          "accent-foreground": "oklch(0.25 0.03 293)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "destructive-foreground": "oklch(0.985 0 0)",
          "border": "oklch(0.9 0 0)",
          "input": "oklch(0.62 0 0)",
          "ring": "oklch(0.55 0.2 293)",
          "radius": "0.625rem"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.78 0.14 293)",
          "primary-foreground": "oklch(0.205 0.03 293)",
          "secondary": "oklch(0.3 0.01 293)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.3 0 0)",
          "muted-foreground": "oklch(0.78 0 0)",
          "accent": "oklch(0.32 0.02 293)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "destructive-foreground": "oklch(0.205 0 0)",
          "border": "oklch(1 0 0 / 12%)",
          "input": "oklch(1 0 0 / 50%)",
          "ring": "oklch(0.78 0.14 293)",
          "radius": "0.625rem"
        },
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-destructive": "var(--destructive)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-border": "var(--border)",
          "color-input": "var(--input)",
          "color-ring": "var(--ring)",
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)"
        }
      }
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Legion cn utility",
      "description": "The class merge helper used by Legion components.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "packages/ui/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A token-driven action control with five variants, three sizes, and six states.",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority",
        "clsx",
        "lucide-react",
        "tailwind-merge"
      ],
      "registryDependencies": [
        "http://localhost:3000/r/theme.json",
        "http://localhost:3000/r/utils.json"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        },
        {
          "path": "packages/ui/registry/button.legion.json",
          "type": "registry:file",
          "target": "@ui/button.legion.json"
        }
      ],
      "meta": {
        "legion": {
          "version": "0.1.0",
          "source": "http://localhost:3000/r/button.json",
          "docs": {
            "en": "http://localhost:3000/docs/components/button",
            "id": "http://localhost:3000/id/docs/components/button"
          }
        }
      }
    }
  ]
}
