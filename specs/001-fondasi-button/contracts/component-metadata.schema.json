{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legion:schema:component-metadata:1",
  "title": "Legion component metadata",
  "description": "Machine-readable metadata generated for each Legion v4 component. Generated from the component source, JSDoc, registry manifest, and component docs; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "title",
    "description",
    "version",
    "type",
    "files",
    "dependencies",
    "registryDependencies",
    "variants",
    "sizes",
    "props",
    "examples",
    "a11y",
    "docs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Registry item name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "Package version that produced this component."
    },
    "type": {
      "const": "registry:ui"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Repository-relative source files that make up the component."
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "npm packages imported by the component at runtime."
    },
    "registryDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://",
        "minLength": 1
      },
      "description": "Registry items installed alongside this component."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prop"
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "a11y": {
      "$ref": "#/$defs/a11y"
    },
    "docs": {
      "$ref": "#/$defs/docs"
    }
  },
  "$defs": {
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": ["string", "null"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence JSDoc summary."
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "codePath"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "codePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.tsx$"
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "criteria", "checklistPath", "manualStatus"],
      "properties": {
        "standard": {
          "const": "WCAG 2.2 AA"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "WCAG success criterion number, e.g. 1.4.11."
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "checklistPath": {
          "type": "string",
          "pattern": "\\.a11y\\.md$"
        },
        "manualStatus": {
          "enum": ["not-run", "pass", "fail"]
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "markdownUrl", "prosePath", "sourcePath"],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/docs/components/[a-z0-9-]+$"
        },
        "markdownUrl": {
          "type": "string",
          "pattern": "^/docs/components/[a-z0-9-]+\\.md$"
        },
        "prosePath": {
          "type": "string",
          "pattern": "\\.md$"
        },
        "sourcePath": {
          "type": "string",
          "pattern": "\\.tsx$"
        }
      }
    }
  }
}
