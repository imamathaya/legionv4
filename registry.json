{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "legionv4",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Legion v4 theme",
      "description": "Semantic light and dark tokens plus their Tailwind mappings.",
      "cssVars": {
        "light": {},
        "dark": {},
        "theme": {}
      }
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Legion cn utility",
      "description": "Joins conditional class names and resolves Tailwind conflicts.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "packages/ui/src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Token-driven action control with five variants, three sizes, and six states.",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority",
        "lucide-react"
      ],
      "registryDependencies": [
        "http://localhost:3000/r/theme.json",
        "http://localhost:3000/r/utils.json"
      ],
      "files": [
        {
          "path": "packages/ui/src/components/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        },
        {
          "path": "packages/ui/registry/button.legion.json",
          "type": "registry:file",
          "target": "@ui/button.legion.json"
        }
      ]
    }
  ]
}
